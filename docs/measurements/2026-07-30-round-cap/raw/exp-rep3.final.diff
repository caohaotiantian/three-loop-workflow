+_sweep_dir=$(mktemp -d); _sweep_file="$_sweep_dir/cases.txt"
+_sweep_want=(); _sweep_sent=()
+sweep_case() { _sweep_want+=("$1"); _sweep_sent+=("$2"); }  # sweep_case catches|admits <sentence>
+# Figures. Grouped by the arm each one exercises. Whether every arm is actually pinned is not decided
+# here and is not asserted in a comment — see the mutation loop below, which breaks each piece in turn
+# and requires a case to notice. A comment claiming the table pins a piece is not evidence that any
