+sweep_case admits  'the reviewer returns written percentages, not raw counts'
+
+printf '%s\n' "${_sweep_sent[@]}" > "$_sweep_file"
+# The count goes to stdout because the caller reads it; the disagreements go to a file, following the
+# harnesses above, so that capturing the count cannot swallow the report of what disagreed.
+sweep_run() {  # sweep_run — echoes how many cases disagree with $STAT; names them in $_sweep_dir/bad
+  local marks i n=0 want got
+  marks=" $(stat_scan "$_sweep_file" 2>/dev/null | sed -E 's/^([^:]*:)?([0-9]+):.*$/\2/' | tr '\n' ' ')"
+  : > "$_sweep_dir/bad"
+  i=0
+  while [ "$i" -lt "${#_sweep_sent[@]}" ]; do
+    want="${_sweep_want[$i]}"
+    case "$marks" in *" $((i+1)) "*) got=catches ;; *) got=admits ;; esac
+    if [ "$got" != "$want" ]; then
+      n=$((n+1))
+      printf '        wanted %-8s got %-8s %s\n' "$want" "$got" "${_sweep_sent[$i]}" >> "$_sweep_dir/bad"
+    fi
+    i=$((i+1))
+  done
+  printf '%s' "$n"
+}
+_sweep_bad=$(sweep_run)
+if [ "$_sweep_bad" = 0 ]; then
+  ok "the statistic sweep behaves on ${#_sweep_sent[@]} pinned sentences"
+else
+  bad "the statistic sweep is wrong on $_sweep_bad of ${#_sweep_sent[@]} pinned sentences:"
+  cat "$_sweep_dir/bad"
+fi
+
+# The table's own property, executed rather than claimed. Break one named piece of the sweep, re-run
+# every case, and require at least one of them to notice. A piece nothing notices is not covered,
+# whatever the comment beside it says: an unpinned `\b`, decimal tail or compound reads as coverage and
+# is none. The token list is read back off the pattern rather than written out again, so a number word
+# added to RULENUM or COUNTNUM without a case fails HERE, on the commit that adds it, rather than
+# whenever someone next re-reads the enumeration.
+# What this does not do, stated as a boundary: the structural pieces are named by hand in `stat_build`,
+# so a new sub-expression added without a name is still unmutated. Review is still the mechanism.
+_pieces='pct-anchor pct-symbol pct-word pct-gap points find-anchor bound-wide bound-tight digits compound rule-split'
+for _t in $(printf '%s|%s' "$RULENUM" "$COUNTNUM" | tr '|' ' '); do _pieces="$_pieces word:$_t"; done
+_unpinned=''; _nmut=0
+for _p in $_pieces; do
+  _nmut=$((_nmut+1))
+  stat_build "$_p"
+  [ "$(sweep_run)" = 0 ] && _unpinned="$_unpinned $_p"
+done
+stat_build
+if [ -z "$_unpinned" ]; then
+  ok "every piece of the sweep is pinned by a case ($_nmut mutations, each one noticed)"
+else
+  bad "the table notices nothing when these are broken:$_unpinned"
+fi
+
+_stat_hits=$(stat_scan three-loop-workflow/ || true)
+if [ -n "$_stat_hits" ]; then
   bad "a statistic is back in the shipped skill:"
-  grep -rnE '[0-9]+(\.[0-9]+)?%|percentage points|116 findings' three-loop-workflow/
