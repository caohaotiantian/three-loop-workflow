+# rewording. `percentage points` stays spelled out because it is the one form that carries no numeral
+# of its own.
+# No decimal tail `(\.[0-9]+)?` and no compound `([- ]$WORDNUM)?` in this arm: neither can decide
+# anything the rest of it does not already decide. Without them, `56.5%` is caught at `5%` — the `.`
+# puts a word boundary in front of the fraction — and `forty-seven percent` at `seven percent`. A
+# sub-expression no case in the table below can notice is not coverage, so it is not carried.
+# The second alternation is a count of FINDINGS, which is the shape both figures that reached the
+# shipped surface were written in: a numeral, then AT MOST TWO words containing no punctuation, then
+# the noun. The qualifier run is deliberately not an enumeration. A closed adjective list
+# ("non-blocking|blocking|confirmed|reported") is escaped by picking a fifth word — `twenty-one
+# confirmed severe findings` walks straight through it, as do `21 real findings` and `21 of the
+# findings`. Two words with no punctuation is a noun phrase, which is the actual property: a count and
+# the thing counted do not straddle a comma, a dash, or a sentence end. The bound is pinned from both
+# sides below — `ten gates returned no findings` is three words away and fires if the bound is widened,
+# and `Ten of the twenty-one confirmed severe findings` is two words away and stops being caught if it
+# is tightened.
+# Not a character window. "A numeral within 40 characters of `findings`" matches the shape of the
+# skill's rule prose rather than the shape of a statistic — build.md:38, "Deep: two, in parallel,
+# independent — union their findings", clears it by a single character, and deleting the word
+# "independent" or swapping the dash for a colon makes the gate fail on a correct document. Word
+# boundaries alone do not fix that; the window itself is the defect.
+# The numeral is either spelling. Matching only the words reads the defect too literally — "Ten of the
+# twenty-one" and "10 of the 21" are one defect, and digits are the likelier way for the next one to be
+# written. Digits are also the safe half to widen: the argument for scoping this arm to counts of
+# findings is that the skill states RULE values in words ("Three fix rounds per phase", "Standard: one
+# reviewer"), and none of those is at risk from a digit.
+# What it does not catch, stated as a boundary rather than as an assurance — a wording here that reads
+# as coverage overstates what the code does. It catches a PERCENTAGE in either spelling of either half,
+# and a COUNT OF FINDINGS where the numeral is digits or one of the
+# words listed above and sits within two unpunctuated words of the noun. Everything else is missed:
+# any other quantity, a count of anything but findings, a numeral separated from it by punctuation or
+# by three words. A general sweep for numbers is not available — one that fired on the rule values
+# above ("Three fix rounds per phase", "Standard: one reviewer") would be turned off within a release,
+# and then the two holes this does close are uncovered too. Review is still the mechanism.
+# A literal like `116 findings` needs no alternative of its own: it is this shape with the numeral
+# frozen, so the general arm subsumes it — and a hardcoded copy is what rule one at the top of this
+# file says not to keep.
+# The numeral here is NOT the one the percentage arm uses. `one`, `two` and `three` are how this skill
+# writes its rules, so a bare RULENUM in front of `findings` is its own register, not a statistic. All
+# of these are correct prose, and a swept RULENUM fails the gate, which blocks CI, on every one of them:
+# `**Standard: one reviewer. Deep: two reviewers union findings.**` — a one-word-shorter reword of the
+# sentence build.md:38 ships — `If one of the findings is a phantom, triage catches it`, `one review,
+# one set of findings`. The qualifier bound cannot be what separates them: `21 of the findings were
+# defects` has to catch and `one of the findings` has to be admitted, and those are one shape with two
+# numerals, so no bound over that alternation tells them apart. The split is therefore made on the
+# numeral. Digits are untouched — the argument above for widening to digits is exactly that the skill
+# states rule values in WORDS — and a compound stays in, because that is one of the ways such a count
+# gets written (`Ten of the twenty-one confirmed findings`).
+# The cost, named rather than assured: a spelled-out count of zero, one, two or three findings is
+# admitted — `the second reviewer added two findings` is a statistic this arm will not see. That is the
+# cost `zero` alone already carries, paid over the four numbers that carry the same risk, and it buys a
+# gate that does not accuse the document it guards. `2 findings` is still caught.
+
+# Both arms are assembled by a function rather than by straight-line assignment, so that the fixture
+# table below can be re-run against a BROKEN copy of the sweep. `stat_build` with no argument builds
+# the real thing; every other argument breaks exactly one named piece of it. That is the only reason
+# this is a function: the property the table claims — every piece is noticed by some case — is not a
+# property you can read, and the mutation loop under the table is what executes it.
+_alt() (  # _alt <arm>... — joins the non-empty arms into one group. An emptied arm is DROPPED rather
+          # than left as an empty alternative, which would match the empty string at every position
+          # and make every mutation look as though the table had noticed it.
+  out=""
+  for a in "$@"; do [ -n "$a" ] || continue; out="${out:+$out|}$a"; done
+  [ -n "$out" ] || out='\bx\b\bx\b'   # unreachable: mutations break one piece at a time
+  printf '(%s)' "$out"
+)
+_drop() (  # _drop <token> <a|b|c> — the alternation without that token
+  IFS='|'; out=""
+  for t in $2; do [ "$t" = "$1" ] || out="${out:+$out|}$t"; done
+  printf '%s' "$out"
+)
+stat_build() {  # stat_build [piece-to-break] — sets STAT
+  local brk="${1:-}"
+  local rule="$RULENUM" count="$COUNTNUM"
+  local pct_anchor='\b' pct_sym='%' pct_word='percent' pct_gap=' ?' points='percentage points'
+  local find_anchor='\b' bound='{0,2}' digits='[0-9]+' compound=y rulesplit=y
+  case "$brk" in
+    '')          ;;
+    pct-anchor)  pct_anchor='' ;;
+    pct-symbol)  pct_sym='' ;;
+    pct-word)    pct_word='' ;;
+    pct-gap)     pct_gap='' ;;
+    points)      points='' ;;
+    find-anchor) find_anchor='' ;;
+    bound-wide)  bound='{0,3}' ;;
+    bound-tight) bound='{0,1}' ;;
+    digits)      digits='' ;;
+    compound)    compound='' ;;
+    rule-split)  rulesplit='' ;;   # RULENUM back in the findings arm, where it accuses rule prose
+    word:*)      rule=$(_drop "${brk#word:}" "$rule"); count=$(_drop "${brk#word:}" "$count") ;;
+    *)           bad "stat_build: no such piece '$brk'"; return 1 ;;
+  esac
+  local wordnum bare pct findcount
+  wordnum=$(_alt "$rule" "$count")
+  pct="$pct_anchor$(_alt "$digits" "$wordnum")$pct_gap$(_alt "$pct_sym" "$pct_word")"
+  [ -n "$points" ] && pct="$pct|$points"
+  if [ -n "$rulesplit" ]; then bare="($count)"; else bare="$wordnum"; fi
+  findcount="$find_anchor$(_alt "$digits" "${compound:+${wordnum}[- ]${wordnum}}" "$bare")"
+  findcount="$findcount( [A-Za-z-]+)$bound findings"
+  STAT="$pct|$findcount"
+}
