+HOST = re.compile(r"\bthis repositor(?:y|y's|ies)\b", re.I)
+ITEM = re.compile(r"\n(?=[ \t]*(?:[-*+][ \t]|\d+[.)][ \t]|\|))")
+def statements(para):
+    for block in ITEM.split(para):
+        for sent in re.split(r"(?<=[.!?])\s+", " ".join(block.split())):
+            if sent: yield sent
+ok, bad = {}, []
+for dirpath, _, names in os.walk("three-loop-workflow"):
+    for n in sorted(names):
+        p = os.path.join(dirpath, n)
+        try: text = io.open(p, encoding="utf-8").read()
+        except (UnicodeDecodeError, OSError): continue
