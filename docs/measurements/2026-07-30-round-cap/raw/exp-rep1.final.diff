+for b in bad: print(f"  MISS  {b}")
+sys.exit(1 if bad else 0)
+PYPATH
+then
+  ok "every scripts/ path the shipped skill names resolves"
+else
+  bad "the shipped skill names a script that does not exist in the shipped skill (listed above)"
+fi
