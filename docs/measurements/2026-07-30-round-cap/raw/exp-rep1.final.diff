+# is ONE paragraph, so joining the paragraph and splitting on terminal punctuation collapsed the whole
+# list into one sentence and one clause, and a negator in any bullet then answered for a claim in a
+# different bullet. That is A1 again through formatting rather than through scoping, and the shipped
+# skill is bullet-heavy. Table rows are the same shape for the same reason. A8/A8b/A8c pin it.
+ITEM = re.compile(r"\n(?=[ \t]*(?:[-*+][ \t]|\d+[.)][ \t]|\|))")
+def statements(para):
+    for block in ITEM.split(para):
+        for sent in re.split(r"(?<=[.!?])\s+", " ".join(block.split())):
+            if sent: yield sent
+bad = []
+for dirpath, _, names in os.walk("three-loop-workflow"):
+    for n in sorted(names):
+        p = os.path.join(dirpath, n)
+        try: text = io.open(p, encoding="utf-8").read()
+        except (UnicodeDecodeError, OSError): continue
+        for para in re.split(r"\n\s*\n", text):
