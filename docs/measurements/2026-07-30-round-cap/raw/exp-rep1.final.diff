+if python3 - <<'PYSHA'
+import io, os, re, sys
+# The CLAIM is a co-occurrence of an ACT and its OBJECT, in either order — not a wording, and not a
+# pair of stems. The first cut pinned one surface form — lowercase, singular, active, with an article —
+# and three near neighbours went straight past it: "detects a fabricated SHA" (the conventional
+# capitalisation of the acronym), "detects fabricated shas", and "the fabrication is detected by the
