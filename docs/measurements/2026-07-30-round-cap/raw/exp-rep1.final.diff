+#!/usr/bin/env bash
+# Mutation test for the prose sweeps in scripts/accept-release.sh.
+#
+# Same contract as scripts/negative-test.sh, aimed at a different target. negative-test.sh breaks
+# phase.js and requires sim-phase.js to notice; this one breaks the SHIPPED DOCUMENTS and requires
+# accept-release.sh to notice. It exists because two sweeps were added to that script that could not
+# fail on the defect they were written for, and nothing would have said so:
+#   A1  the fabricated-sha sweep filtered its negation by LINE, and build.md is one paragraph per
+#       line — so a positive claim appended to the negation's own paragraph was filtered out with it.
+#       Demonstrated in a fresh clone: `ACCEPT: all checks passed`, exit 0, no FAIL of any kind.
+#   A1b the same sweep, after A1 was fixed by scoping the negator to the SENTENCE: a negator in an
+#       earlier clause, about a different subject, still masked the claim. Same exit 0, same silence.
+#   A3  the script-path check accepted the host repo root as a second search root, so a skill document
+#       could name a script that ships only with this repository and not with the skill. Demonstrated
+#       with `scripts/negative-test.sh`, which printed `ok referenced script exists`.
+#   A5  the same check then read only `*.md`, so the identical misrouting inside one of the skill's
+#       two shipped SCRIPTS was invisible. Demonstrated on phase.js: exit 0, zero FAIL.
+#   A9  the same check extracted only `scripts/NAME.js` and `scripts/NAME.sh`, under a header and an
+#       ok line that both say EVERY scripts/ path — so `scripts/verify-plan.py` and
+#       `scripts/lib/verify-plan.js` resolved nowhere and acceptance said every path resolved.
+#   A1d the sweep then scoped negation by splitting on clause boundaries — but " but " coordinates two
+#       adjectives as readily as two clauses, and there the split cut the claim in half.
+#   A7  the sweep pinned the stems `detect*` and `fabricat*` and missed the OPERATIONAL half of the
+#       regression it was written for: 4105e9d's second sentence, appended verbatim, exit 0, zero FAIL.
+#   A8  the sweep read a Markdown list as one sentence, because a list is one paragraph and its items
+#       carry no full stops — so one bullet's negator answered for another bullet's claim. A6b is the
+#       same collapse in the script-path check, where it moved the host-repo marker off the path.
+#   A1h every clause boundary the sweep knew was recognised by what STARTS the next clause, so the
+#       comma closing a fronted subordinate clause was not one — and in "Because …, the script detects
+#       a fabricated sha" the subordinate clause's negator answered for the main clause's claim.
+#   B9  every acceptance case was a restatement of the sha limit itself, so none of them could see a
+#       sweep that had stopped requiring the sentence to be about a sha: ordinary prose on other
+#       subjects ("Triage rejects invented findings before the count.") failed acceptance.
+# A2, A4 and A6 are the cases those sweeps did already catch, pinned here so a fix to A1/A3/A5 cannot
+# quietly trade one direction of the check away for the other. B1-B12 are the opposite direction
+# again: prose the skill is entitled to write, which acceptance must not reject.
+#
+# It cannot be called from accept-release.sh — that script already calls negative-test.sh, and calling
+# this one would recurse. CI runs it as its own step.
+#
+# The tree under test is a COPY of the working tree, `.git` included, so the mutations never touch the
+# checkout you are sitting in and an interrupted run leaves nothing behind. The copy carries
+# uncommitted edits on purpose: a harness that silently tested HEAD would go green on the fix you have
+# not committed yet, which is the same false report it exists to prevent.
+#
+# A patch that no longer matches its file is a FAILURE, not a skip. And the unmutated copy has to PASS
+# first — without that control, a tree that fails acceptance for any unrelated reason makes every
+# mutation below look detected.
+set -uo pipefail
+cd "$(git rev-parse --show-toplevel)"
+root=$(pwd)
+
+TMP=$(mktemp -d)
+trap 'rm -rf "$TMP"' EXIT
+TREE="$TMP/tree"
+mkdir -p "$TREE"
+tar -cf - . | (cd "$TREE" && tar -xf -)
+
+fail=0
+
+echo "== control: the unmutated copy must pass, or nothing below is evidence =="
+if (cd "$TREE" && bash scripts/accept-release.sh) >"$TMP/base" 2>&1; then
+  echo "  ok        the working tree passes acceptance ($(grep -c '^  ok' "$TMP/base" | tr -d ' ') checks)"
+else
+  echo "  ERROR     acceptance already FAILS on this tree — fix that first, every result below is void"
+  grep '^  FAIL' "$TMP/base"
+  exit 1
+fi
+
+# mutate <name> <file-under-test> <python-patch-on-s>
+# Edits the copy. A patch that no longer matches its file is a FAILURE, not a skip — it means the
+# case below is testing nothing, which is the report this harness exists to prevent.
+mutate() {
+  local name="$1" file="$2" patch="$3"
+  cp "$root/$file" "$TREE/$file"
+  ACCEPT_PATCH="$patch" python3 - "$TREE/$file" <<'PY'
+import os, sys
+p = sys.argv[1]
+s = open(p, encoding='utf-8').read()
+exec(os.environ['ACCEPT_PATCH'])
+open(p, 'w', encoding='utf-8').write(s)
+PY
+  if cmp -s "$root/$file" "$TREE/$file"; then
+    printf '  ERROR     %s: the mutation did not apply — the patch no longer matches %s\n' "$name" "$file"
+    fail=$((fail+1)); cp "$root/$file" "$TREE/$file"; return 1
+  fi
+  return 0
+}
+
+# apply <name> <file-under-test> <python-patch-on-s> <expected-FAIL-substring>
+# The expected FAIL is required, not decorative. These mutations edit prose, and accept-release.sh runs
+# a hundred other checks over the same prose — a mutation that trips an unrelated sweep would exit
+# non-zero and look detected while the check under test stayed silent. Naming the FAIL is what makes
+# "detected" mean "detected BY THE CHECK THIS MUTATION TARGETS".
+apply() {
+  local name="$1" file="$2" patch="$3" want="$4"
+  mutate "$name" "$file" "$patch" || return
+  if (cd "$TREE" && bash scripts/accept-release.sh) >"$TMP/out" 2>&1; then
+    printf '  SURVIVED  %s — accept-release.sh exited 0 on a tree that breaks the rule\n' "$name"
+    fail=$((fail+1))
+  elif grep '^  FAIL' "$TMP/out" | grep -qF "$want"; then
+    printf '  detected  %s (%s check(s) failed)\n' "$name" "$(grep -c '^  FAIL' "$TMP/out" | tr -d ' ')"
+  else
+    printf '  WRONG     %s — acceptance failed, but not on "%s". It reported:\n' "$name" "$want"
+    grep '^  FAIL' "$TMP/out" | sed 's/^/            /'
+    fail=$((fail+1))
+  fi
+  cp "$root/$file" "$TREE/$file"
+}
+
+# accepts <name> <file-under-test> <python-patch-on-s>
+# The other direction, and the one a mutation test cannot see on its own: prose the shipped skill is
+# ENTITLED to write, which acceptance must not reject. Every `apply` above asserts that a check can
+# fail; without these, the cheapest way to make them all pass is a check that fails on everything. The
+# repo's own disqualifier, from the round that dropped a check rather than tune it: a gate that fails
+# on right writing is the same defect as one that passes on wrong writing.
+accepts() {
+  local name="$1" file="$2" patch="$3"
+  mutate "$name" "$file" "$patch" || return
+  if (cd "$TREE" && bash scripts/accept-release.sh) >"$TMP/out" 2>&1; then
+    printf '  accepted  %s\n' "$name"
+  else
+    printf '  REJECTED  %s — acceptance FAILED on prose the skill is entitled to write:\n' "$name"
+    grep '^  FAIL' "$TMP/out" | sed 's/^/            /'
+    fail=$((fail+1))
+  fi
+  cp "$root/$file" "$TREE/$file"
+}
+
+BUILD=three-loop-workflow/references/build.md
+
+echo "== mutation test: a claim the shipped skill must not make =="
+
+# The bypass. The sentence is appended to line 218 — the negation's OWN paragraph — which is where a
+# writer updating this passage would naturally put it, and which is where the previous regression
+# (4105e9d) actually landed.
+apply "A1 'it detects a fabricated sha' added to the paragraph that carries the negation" "$BUILD" \
+  'assert "it does not detect a fabricated sha" in s
+s = s.replace("it does not detect a fabricated sha.",
+              "it does not detect a fabricated sha. As of this release the script now detects a fabricated sha.", 1)' \
+  "claims the fabrication is detected"
+
+# The same defect class as A1 — a positive claim landing beside the negation — but reached the way a
+# writer CORRECTING that passage would reach for it: a contrast against the existing negation, in the
+# same sentence. A1's fix scoped the negator to the sentence, which is why this one still survived it:
+# the negator sits in the other clause, about the other subject. Negation in English scopes to a
+# clause, so the check has to as well.
+apply "A1b 'it detects a fabricated sha' contrasted against a negated clause in the same sentence" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nIt does not merely make the fabrication harmless; it detects a fabricated sha and stops the phase.\n"' \
+  "claims the fabrication is detected"
+
+# The same masking through a coordinating conjunction rather than a semicolon, and with the negator
+# attached to a different subject entirely.
+apply "A1c the claim behind a ', but' whose negator belongs to another subject" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nThe manual path cannot do this, but the script detects a fabricated sha and stops the phase.\n"' \
+  "claims the fabrication is detected"
+
+# A1d–A1f: the same class reached THROUGH the splitter instead of around it. " but ", " yet " and
+# " though " are clause boundaries only some of the time; between two adjectives they coordinate inside
+# one noun phrase, and splitting there cuts the claim in half so neither fragment carries both stems.
+# A1d isolates that from the CLAIM regex: it matches the unsplit sentence and nothing matches after the
+# split. A1e is the sentence a writer would actually produce, in build.md:218's own vocabulary — and it
+# needs a second fix, because "well-formed" is not one gap token to a regex whose token class has no
+# hyphen, so CLAIM misses A1e even unsplit.
+apply "A1d the claim split by a ' but ' coordinating two adjectives, not two clauses" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nIt detects a valid but fabricated sha and stops the phase.\n"' \
+  "claims the fabrication is detected"
+
+apply "A1e the same with the hyphenated modifier build.md:218 itself uses" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nIt detects a well-formed but fabricated sha and stops the phase.\n"' \
+  "claims the fabrication is detected"
+
+apply "A1f the same through ' yet ' and ' though ', which coordinate inside a phrase too" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nIt detects a well-formed yet fabricated sha.\n\nIt detects a valid though fabricated sha.\n"' \
+  "claims the fabrication is detected"
+
+# The counterweight to A1d-A1f: those words are STILL clause boundaries when they start a clause, and
+# the negator on the other side of one must still not reach the claim. Without this, the cheapest way
+# to pass A1d is to drop them from the boundary set, which reopens A1c one conjunction over.
+apply "A1g the claim behind a clause-initial ' while ' whose negator belongs to another subject" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nThe manual path cannot do this while the script detects a fabricated sha and stops the phase.\n"' \
+  "claims the fabrication is detected"
+
+# A1h/A1i are A1b/A1c/A1g's class reached through the commonest sentence shape in English: a fronted
+# subordinate clause, then a comma, then the main clause. Every boundary the sweep knew was identified
+# by what STARTS the next clause — punctuation, a coordinator, a comma before a finite verb — and what
+# follows this comma is a subject noun phrase, so the sentence read as one clause and the subordinate
+# clause's negator answered for the main clause's claim. A1i is A1c's own sentence with ", but " moved
+# to the front as "Because …, "; A1h is 4105e9d's regressed sentence with "never created" rewritten as
+# "did not create", which is what keeps it out of the OBJ blanking that makes A7 detectable.
+apply "A1h the claim after a fronted 'If …,' whose negator belongs to the subordinate clause" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nIf the implementer reports a sha it did not create, the script detects the fabrication and stops the phase.\n"' \
+  "claims the fabrication is detected"
+
+apply "A1i the same through a fronted 'Because …,' — A1c with the conjunction moved to the front" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nBecause the manual path cannot do this, the script detects a fabricated sha and stops the phase.\n"' \
+  "claims the fabrication is detected"
+
+# The direction the sweep already caught. Pinned so scoping the negation cannot lose it.
+apply "A2 the same claim as its own paragraph" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nAs of this release the script detects a fabricated sha.\n"' \
+  "claims the fabrication is detected"
+
+# A2b–A2d: the same claim in the surface forms a writer actually reaches for. The first cut of the
+# sweep pinned one — lowercase, singular, active, with an article — so all three of these were
+# invisible. A2d is the passive, which is the wording the check's own FAIL message uses.
+apply "A2b the claim with the acronym capitalised the conventional way" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nAs of this release the script detects a fabricated SHA.\n"' \
+  "claims the fabrication is detected"
+
+apply "A2c the claim in the plural, with no article" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nThe script detects fabricated shas.\n"' \
+  "claims the fabrication is detected"
+
+apply "A2d the claim in the passive voice" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nThe fabrication is detected by the guard.\n"' \
+  "claims the fabrication is detected"
+
+# A2e-A2h: the claim is an ACT, and "detect" is one word for it. A sweep pinned to that stem passes
+# every synonym a writer reinstating the guarantee would reach for first. A2h also names the sha the
+# way build.md:218 names it — "a sha it never created" — which carries a negator of its own; the
+# words that NAME the fabricated sha are not a denial that it is caught.
+apply "A2e the claim with 'catches' instead of 'detects'" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nThe script catches a fabricated sha and stops the phase.\n"' \
+  "claims the fabrication is detected"
+
+apply "A2f the claim with 'rejects'" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nThe script rejects a fabricated sha and stops the phase.\n"' \
+  "claims the fabrication is detected"
+
+apply "A2g the claim with 'identifies'" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nThe guard identifies a fabricated sha before review.\n"' \
+  "claims the fabrication is detected"
+
+apply "A2h the claim naming the sha as build.md does, not as 'fabricated'" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nA sha the implementer never created is caught by the guard.\n"' \
+  "claims the fabrication is detected"
+
+# A7 is the operational half of the regression this whole sweep was written for: the SECOND sentence
+# of 4105e9d, verbatim. It carries neither "detect" nor "fabricat", so the stem check never saw it —
+# the sweep pinned that commit's headline sentence and nothing else. What is false in it is that the
+# script resolves the reported sha at all; a Workflow script has no shell. Note both of its negators
+# ("never created", "finds no object") belong to other propositions, which is why clause-wide negation
+# read it as a denial.
+# A8-A8c: A1 again, reached through list formatting. A Markdown list is one paragraph, and items
+# routinely carry no terminal punctuation, so the whole list collapses into one sentence and one
+# clause and any negator in any item answers for a claim in a different item. A8b pins that distance
+# does not help; A8c is the same in a table, which is the other place the skill writes short
+# unpunctuated statements. The shipped skill is bullet-heavy — the SKILL.md guard list, build.md's
+# Gates and Diagnosis — so this is the likeliest formatting for a future regression.
+apply "A8 the claim in a bullet whose neighbouring bullet carries the negator" "$BUILD" \
+  's = s.rstrip("\n") + "\n\n- the reported sha is never resolved\n- it detects a fabricated sha and stops the phase\n"' \
+  "claims the fabrication is detected"
+
+apply "A8b the same with the negator two bullets away" "$BUILD" \
+  's = s.rstrip("\n") + "\n\n- the reported sha is never resolved\n- the phase reviews the real diff\n- it detects a fabricated sha and stops the phase\n"' \
+  "claims the fabrication is detected"
+
+apply "A8c the same across two rows of a table" "$BUILD" \
+  's = s.rstrip("\n") + "\n\n| What | Behaviour |\n| --- | --- |\n| the reported sha | never resolved |\n| the guard | detects a fabricated sha and stops the phase |\n"' \
+  "claims the fabrication is detected"
+
+apply "A7 the false guarantee stated operationally, verbatim from 4105e9d" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nIf the implementer reports a well-formed sha it never created, the script resolves the reported value in the repository, finds no object of that name, and stops the phase with an \x60\x60agent-error\x60\x60.\n"' \
+  "claims the fabrication is detected"
+
+echo "== acceptance test: true statements of the same limit, which must NOT be rejected =="
+
+# B1-B3 are all true, all say the thing build.md:218 already says, and two of them are more natural
+# phrasings of it than the sentence actually shipped. The first cut of the sweep rejected all three:
+# its negator list was `not|never|cannot|n't`, which knows auxiliary negation and not negative
+# subjects ("Nothing", "No part") or periphrastic negation ("is unable to").
+accepts "B1 the limit stated with a negative subject ('Nothing ... detects')" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nNothing in phase.js detects a fabricated sha.\n"'
+
+accepts "B2 the limit stated with a negative determiner ('No part ... detects')" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nNo part of the script detects a fabricated sha.\n"'
+
+accepts "B3 the limit stated periphrastically ('is unable to detect')" "$BUILD" \
+  's = s.rstrip("\n") + "\n\nThe script is unable to detect a fabricated sha.\n"'
+
+# B5-B8 are the counterweights to A2e-A2h and A7. Widening what counts as the claim widens what can be
+# wrongly rejected, and each of these is a true sentence the passage is entitled to contain.
+# B5 pins that a negator mid-clause still counts — the cheapest way to catch A7's "finds no object"
+#    is to demand a clause-initial negator, and that rejects this.
+# B6/B7 pin that "resolves a sha" is judged like any other claim and not forbidden outright — the
+#    cheapest way to catch A7 is an absolute rule on that phrase, and these are how the limit is
+#    truthfully written.
+# B8 pins that masking "never created" out of A2h did not also mask the real negator beside it.
