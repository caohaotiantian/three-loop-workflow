+else
+  bad "the shipped skill claims the fabrication is detected (listed above)"
+fi
+
+echo "== every scripts/ path the shipped skill names resolves =="
+# Not a wording check: it resolves the path. A reader told to run `scripts/x.sh` looks in the skill's
